# EIDE — biến môi trường. Chép thành .env rồi điền khóa thật.
# .env KHÔNG bao giờ được commit (đã có trong .gitignore).
# Tham chiếu: PRS-16 §vai trò LLM, SDD-04 §6 models.yaml, SEC-25 §quản lý bí mật.

# --- Mô hình ngôn ngữ ---
# Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Claude (tùy chọn — dùng cho vai trò cần suy luận dài: planner, architect)
ANTHROPIC_API_KEY=

# --- Chọn mô hình theo vai trò (PRS-16 §1: 9 vai trò) ---
# Để trống thì Gateway dùng mặc định trong docs/spec/ hoặc .eide/models.yaml
#
# Mặc định phát triển và kiểm thử là `gemini-3.8-flash` — chủ sản phẩm chốt 06/09/2026:
# chi phí phù hợp cho vòng lặp test dày, chất lượng đủ cho phần lớn vai trò.
# Tên model đã đối chiếu với API ngày 06/09/2026 (chú ý thứ tự: `gemini-3.8-flash`,
# KHÔNG phải `gemini-flash-3.8`).
EIDE_MODEL_DEFAULT=gemini-3.8-flash
EIDE_MODEL_FAST=gemini-3.8-flash
# Vai trò cần suy luận dài (planner, architect) có thể nâng lên khi cần — xem PRS-16 §1
EIDE_MODEL_HEAVY=gemini-3.8-flash

# --- Vận hành ---
# Mức tự chủ ban đầu khi dự án chưa có .eide/autonomy.yaml (APD-08: A0..A4)
EIDE_AUTONOMY=A2
# Thư mục dữ liệu người dùng; để trống thì dùng platformdirs (PLATFORM.md quy tắc 1)
EIDE_HOME=
# Ghi log gọi mô hình ra ledger để kiểm chứng (SEC-25 §3)
EIDE_LOG_LLM=1
