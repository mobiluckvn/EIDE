# Một venv cho mỗi kiến trúc (PLATFORM.md: macOS arm64 và x86_64 đều là nền tảng thứ tự 1).
# Mẫu phải có dấu sao: `.venv/` không khớp `.venv-arm/`, và cái venv lọt vào staging là
# 2743 tệp không ai đọc.
.venv*/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
build/
# SwiftPM dựng vào `.build/`, và mẫu `build/` KHÔNG khớp nó — dấu chấm đầu là một ký tự thật.
# Lọt vào kho ngày 18/09: 2588 tệp nhị phân, mỗi lần `swift build` lại hiện ra trong `git status`
# và che mất những tệp mã thật sự đổi.
.build/
dist/
*.egg-info/
.DS_Store
docs/sync/*.draft.md

# Bí mật — không bao giờ commit (SEC-25)
.env
.env.local
*.pem
*.p12
# Khóa ký cập nhật Sparkle: bản RIÊNG không bao giờ vào kho; bản CÔNG KHAI thì có
# (build nhúng nó vào Info.plist). Xem DEVIATIONS DEV-004.
*_private.txt
secrets/*_private*

# Hiện vật gốc do chủ sản phẩm nạp vào (zip bộ hồ sơ, bản kho tham khảo)
_incoming/

# Dữ liệu chạy thật
.eide/
*.sqlite
*.sqlite-journal

# Bằng chứng kiểm thử usecase: ảnh chụp và docx từng ca (135 MB + 182 MB).
# Chúng nằm trên đĩa để chủ sản phẩm rà, KHÔNG vào git — một kho đồ án không nên
# mang 300 MB nhị phân sinh lại được. Sinh lại bằng:
#   python scripts/kiem_usecase.py --lai            (chạy lại cả bộ, tốn lời gọi mô hình)
#   hoặc dựng docx từ ket-qua.json đã có, không chạy lại kịch bản.
docs/test/usecase/*/*.png
docs/test/usecase/TC*.docx
docs/test/usecase/*/du-an/
