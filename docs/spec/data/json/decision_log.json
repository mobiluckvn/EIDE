{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://eide.code247.ai/schema/decision_log.json",
 "title": "DecisionLog",
 "description": "Quyết định ở cổng (POL-17)",
 "type": "object",
 "required": [
  "id",
  "action_cap",
  "risk",
  "autonomy_level",
  "decision",
  "by",
  "at"
 ],
 "properties": {
  "id": {
   "type": "string",
   "description": "d_<hex>"
  },
  "gate": {
   "type": "string",
   "enum": [
    "G-SRC",
    "G-FACT",
    "G1",
    "G3",
    "G-OPS",
    "G4",
    "G5",
    "*"
   ]
  },
  "action_cap": {
   "type": "string",
   "description": "id năng lực"
  },
  "risk": {
   "type": "string",
   "enum": [
    "R0",
    "R1",
    "R2",
    "R3",
    "R4"
   ]
  },
  "autonomy_level": {
   "type": "string",
   "enum": [
    "A0",
    "A1",
    "A2",
    "A3",
    "A4"
   ],
   "description": "Mức hiệu lực"
  },
  "decision": {
   "type": "string",
   "enum": [
    "APPROVE",
    "ASK",
    "REJECT"
   ]
  },
  "by": {
   "type": "string",
   "enum": [
    "policy",
    "human"
   ]
  },
  "rule": {
   "type": "string",
   "description": "Mã quy tắc"
  },
  "reason": {
   "type": "string"
  },
  "evidence": {
   "type": "array",
   "description": "JSON"
  },
  "features": {
   "type": "object",
   "description": "JSON đặc trưng"
  },
  "human_answer": {
   "type": "string",
   "description": "Nếu ASK → người trả lời"
  },
  "undone_at": {
   "type": "string",
   "format": "date-time"
  },
  "at": {
   "type": "string",
   "format": "date-time"
  }
 },
 "additionalProperties": false
}